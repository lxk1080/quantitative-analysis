DATABASE_PATH=./data/quant.db
PYTHON_BIN=python
MARKET_DATA_PROVIDER=akshare
AKSHARE_MAX_WORKERS=4
TUSHARE_TOKEN=
# false avoids a stale local proxy such as 127.0.0.1:7890. Set true only if required.
TUSHARE_USE_SYSTEM_PROXY=false
# Tushare free daily endpoint is limited to 50 requests/minute. Do not lower below 1.3.
TUSHARE_DAILY_MIN_INTERVAL_SECONDS=1.3
